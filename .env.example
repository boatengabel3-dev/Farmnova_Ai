# GEMINI_API_KEY: Required for Gemini AI API calls (Alpha Assistant explanation & speech fallback).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GHANANLP_API_KEY: Optional subscription key for Khaya AI / GhanaNLP (Translation, ASR, TTS).
GHANANLP_API_KEY=""

# NASA_EARTHDATA_TOKEN: Optional Earthdata Bearer token for authenticated NASA granules (GPM IMERG, SMAP, ECOSTRESS).
NASA_EARTHDATA_TOKEN=""

# METEOMATICS_USERNAME & METEOMATICS_PASSWORD: Required for live Meteomatics Weather API forecasts & surface soil water updates.
METEOMATICS_USERNAME=""
METEOMATICS_PASSWORD=""

# Supabase Project & Edge Function configuration (supports SUPABASE_* or NEXT_PUBLIC_SUPABASE_*).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_EDGE_FUNCTION_URL=""
